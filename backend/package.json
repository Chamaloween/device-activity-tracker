{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API server for device activity tracking",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:server": "npx tsx src/server.ts",
    "start:server:with-signal": "npx tsx src/scripts/init-signal.ts && npx tsx src/server.ts",
    "start:signal-api": "npx tsx src/scripts/init-signal.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.1.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "private": true
}